char* intToRoman(int num) {
    int values[] = {
        1000, 900, 500, 400,
        100, 90, 50, 40,
        10, 9, 5, 4, 1
    };

    char* symbols[] = {
        "M", "CM", "D", "CD",
        "C", "XC", "L", "XL",
        "X", "IX", "V", "IV", "I"
    };

    char* result = malloc(20 * sizeof(char));
    int i = 0;
    int k = 0;

    while (num > 0) {
        while (num >= values[k]) {
            num -= values[k];

            for (int j = 0; symbols[k][j] != '\0'; j++) {
                result[i++] = symbols[k][j];
            }
        }
        k++;
    }

    result[i] = '\0';

    return result;
}